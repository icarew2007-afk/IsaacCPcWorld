<form class="ui form" action="/computer/{{categoryId}}/editproduct/{{product.id}}" method="POST">
  <div class="field">
    <label>Product Name</label>
    <input type="text" name="title" value="{{product.title}}" required>
  </div>
  <div class="field">
    <label>Brand</label>
    <input type="text" name="brand" value="{{product.brand}}" required>
  </div>
  <button class="ui blue button" type="submit">Update Product</button>
</form>
