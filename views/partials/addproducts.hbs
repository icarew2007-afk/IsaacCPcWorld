<form class="ui stacked segment form" action="/computer/{{id}}/addproduct" method="POST" enctype="multipart/form-data">
  <div class="three fields">
    <div class="field">
      <label>Product Name</label>
      <input type="text" name="product" autofocus required title="Please include a valid product name" placeholder="Product Name">
    </div>
    <div class="field">
      <label>Brand</label>
      <input type="text" name="brand" required title="Please include a valid brand name" placeholder="Brand">
    </div>
    <div class="field">
      <label>Image</label>
      <input type="file" name="image" accept="image/*" required title="Please upload a valid image file">
  </div>
  <button class="ui blue submit button">Add Product</button>
</form>
